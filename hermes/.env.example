# ── NEAR Intents Agent API ────────────────────────────────────────────────
# Testnet (Tidepool — free, tokens have no value). This is the default.
AGENT_API_URL=https://www.usetidepool.tech

# Partner API key (naa_...). On testnet you can leave this empty:
# `npm run provision` mints a free key via POST /v1/keys and caches it in .state/.
# For mainnet, set your real key and AGENT_API_URL=https://api.agentsonintents.com
AGENT_API_KEY=

# Written by `npm run provision` after provisioning the agent + grant:
AGENT_ID=
HERMES_GRANT_TOKEN=
OWNER_ACCOUNT_ID=

# Mainnet-only: a NEAR account you control + the private key of one of its
# full-access keys (32-byte seed, hex or base64). On testnet, provisioning
# generates a throwaway implicit-account key instead (no on-chain account).
OWNER_PRIVATE_KEY=

# ── NEAR AI Cloud (Hermes' LLM provider) ─────────────────────────────────
# Key from https://cloud.near.ai → API Keys. Hermes reads profile/.env, which
# provision keeps in sync; this copy is the source of truth for recipes/tests.
NEAR_AI_API_KEY=

# ── Test gating ───────────────────────────────────────────────────────────
# Set to 1 to run the tier-3 e2e tests that drive the real Hermes agent
# (requires: hermes on PATH, NEAR_AI_API_KEY set, `npm run provision` done).
RUN_HERMES=0
