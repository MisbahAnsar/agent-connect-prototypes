# ── Network ───────────────────────────────────────────────────────────────
# tidepool (default: NEAR Intents testnet — free, tokens have no value)
#   or mainnet (real funds; agentsonintents.com)
NETWORK=tidepool

# Optional: override the API base URL entirely (e.g. a staging deployment).
# The provisioned network is cached in .state/, so keep this stable per state dir.
AGENT_API_URL=

# ── NEAR Intents Agent API ────────────────────────────────────────────────
# Partner API key (naa_...). On tidepool you can leave this empty:
# `npm run provision` mints a free key via POST /v1/keys and caches it in .state/.
# On mainnet a real key is required.
AGENT_API_KEY=

# ── Owner ─────────────────────────────────────────────────────────────────
# On tidepool, provision generates a throwaway implicit-account key (no on-chain
# account, nothing to fund) and caches it in .state/owner-key.json.
# On mainnet, set these to a dedicated, low-value NEAR account you control:
OWNER_ACCOUNT_ID=
OWNER_PRIVATE_KEY=

# Optional RPC for nep366 (gasless delegate action) signing. Only needed if the
# API asks for nep366 intents. Defaults to the NEAR mainnet RPC.
NEAR_RPC_URL=

# ── House Money ───────────────────────────────────────────────────────────
# Stake asset: by id, or by symbol+chain from the network's catalog (default: USDC on near).
# The ids differ per network — `npm run check` lists what is priced where you point.
HOUSE_STAKE_ASSET=
HOUSE_STAKE_ASSET_SYMBOL=USDC
HOUSE_STAKE_ASSET_CHAIN=near
# Stake in whole units of that asset (e.g. 5).
HOUSE_PRINCIPAL=5
# Risk asset the agent may trade: by id, or by symbol+chain. Leave both empty for no trading.
HOUSE_RISK_ASSET=
HOUSE_RISK_ASSET_SYMBOL=
HOUSE_RISK_ASSET_CHAIN=
# Where the principal exits to (an address you control on the safe chain).
HOUSE_SAFE_CHAIN=base
HOUSE_SAFE_ADDRESS=
# Exit trigger: equity/principal in basis points (20000 = 2x). On tidepool, lower it
# (e.g. 10100) to watch the exit happen on a small stake.
HOUSE_MULTIPLE_BPS=20000
# Veto window in ms (mainnet only — tidepool rejects timelocks). With a risk asset configured
# this delays every swap too, so keep it short while trading (30000); 3600000 (1h) for pure exits.
HOUSE_TIMELOCK_MS=30000

# ── Mainnet safety ────────────────────────────────────────────────────────
# On mainnet, money-moving recipes print the plan and exit unless this is set.
HOUSE_CONFIRM=

# 1 drops `withdraw` from the policy once the principal has settled, so no grant
# can ever withdraw again.
HOUSE_SEAL=0
